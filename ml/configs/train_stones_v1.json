{
  "_comment": "Stones v1 (ADR 0004): train_v3 settings on the stone dataset built by notebooks/01_stones_audit.ipynb.",
  "run_name": "mnv2-stones_v1-s42",
  "split_manifest": "splits/split_manifest_stones_v1.csv",
  "class_file": "configs/stones_v1.json",
  "raw_zip": "stones_v1_raw.zip",
  "kaggle_dataset": "",
  "audit_stats_csv": "stones_v1_image_stats.csv",
  "seed": 42,
  "arch": "mobilenet_v2",
  "alpha": 1.0,
  "image_size": 224,
  "prep_short_side": 288,
  "batch_size": 32,
  "dropout": 0.3,
  "label_smoothing": 0.1,
  "class_weight_power": 1.0,
  "crop_area_min": 0.5,
  "crop_aspect": [
    0.75,
    1.333
  ],
  "flips": true,
  "rot90": true,
  "brightness": 0.15,
  "contrast": 0.15,
  "saturation": 0.15,
  "hue": 0.02,
  "stage1_epochs": 15,
  "stage1_lr": 0.001,
  "unfreeze_frac": 0.6,
  "stage2_epochs": 40,
  "stage2_lr": 0.0001,
  "patience": 8,
  "monitor": "val_top1",
  "deterministic_ops": false,
  "tfjs_converter": "tensorflowjs==4.22.0",
  "tfjs_quantization": "float16",
  "tfjs_max_abs_diff": 0.02,
  "tfjs_npm": "@tensorflow/tfjs@4.22.0",
  "max_web_model_mb": 5.0
}
